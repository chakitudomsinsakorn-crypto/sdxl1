      "source": [
        "#@title 1. ติดตั้งไลบรารีที่จำเป็น (กดรันครั้งเดียว)\n",
        "!pip -q install diffusers transformers accelerate scipy safetensors xformers gradio ipywidgets==7.7.1"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "load_model"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "#@title 2. เลือกและโหลดโมเดล (กดรันแล้วคลิกปุ่ม Apply)\n",
        "from diffusers import StableDiffusionXLPipeline, EulerAncestralDiscreteScheduler, DDIMScheduler, EulerDiscreteScheduler, UniPCMultistepScheduler\n",
        "from diffusers.models import AutoencoderKL\n",
        "import torch, gc\n",
        "import ipywidgets as widgets\n",
        "from google.colab import output\n",
        "\n",
        "output.enable_custom_widget_manager()\n",
        "pipe = None\n",
        "\n",
        "select_model = widgets.Dropdown(\n",
        "    options=[\n",
        "        (\"Animagine XL 4.0\", \"cagliostrolab/animagine-xl-4.0\"),\n",
        "        (\"Stable Diffusion XL Base 1.0\", \"stabilityai/stable-diffusion-xl-base-1.0\"),\n",
        "        (\"SSD-1B (Fast SDXL)\", \"segmind/SSD-1B\"),\n",
        "    ],\n",
        "    value=\"cagliostrolab/animagine-xl-4.0\",\n",
        "    description=\"Select Model:\"\n",
        ")\n",
        "\n",
        "select_sampler = widgets.Dropdown(\n",
        "    options=[\n",
        "        \"EulerAncestralDiscreteScheduler\",\n",
        "        \"EulerDiscreteScheduler\",\n",
        "        \"UniPCMultistepScheduler\",\n",
        "        \"DDIMScheduler\"\n",
        "    ],\n",
        "    description=\"Select Scheduler:\"\n",
        ")\n",
        "select_sampler.style.description_width = \"auto\"\n",
        "\n",
        "out = widgets.Output()\n",
        "apply_btn = widgets.Button(description=\"Apply\", button_style=\"info\")\n",
        "\n",
        "def get_scheduler(name):\n",
        "    schedulers = {\n",
        "        \"EulerAncestralDiscreteScheduler\": EulerAncestralDiscreteScheduler,\n",
        "        \"DDIMScheduler\": DDIMScheduler,\n",
        "        \"EulerDiscreteScheduler\": EulerDiscreteScheduler,\n",
        "        \"UniPCMultistepScheduler\": UniPCMultistepScheduler,\n",
        "    }\n",
        "    return schedulers[name].from_pretrained(select_model.value, subfolder=\"scheduler\")\n",
        "\n",
        "def pipeline(p):\n",
        "    global pipe\n",
        "    out.clear_output()\n",
        "    apply_btn.disabled = True\n",
        "    with out:\n",
        "        print(\"กำลังโหลดโมเดล กรุณารอสักครู่...\")\n",
        "        try:\n",
        "            if pipe is not None:\n",
        "                del pipe\n",
        "                gc.collect()\n",
        "                torch.cuda.empty_cache()\n",
        "\n",
        "            vae = AutoencoderKL.from_pretrained(\"madebyollin/sdxl-vae-fp16-fix\", torch_dtype=torch.float16)\n",
        "            pipe = StableDiffusionXLPipeline.from_pretrained(\n",
        "                select_model.value,\n",
        "                scheduler=get_scheduler(select_sampler.value),\n",
        "                torch_dtype=torch.float16,\n",
        "                use_safetensors=True,\n",
        "                low_cpu_mem_usage=True,\n",
        "                vae=vae\n",
        "            ).to(\"cuda\")\n",
        "\n",
        "            pipe.enable_xformers_memory_efficient_attention()\n",
        "            pipe.vae.enable_tiling()\n",
        "            pipe.vae.enable_slicing()\n",
        "\n",
        "            print(\"โหลดโมเดลเสร็จสมบูรณ์! พร้อมใช้งานในขั้นตอนที่ 3\")\n",
        "        except Exception as e:\n",
        "            print(f\"Error: {e}\")\n",
        "    apply_btn.disabled = False\n",
        "\n",
        "apply_btn.on_click(pipeline)\n",
        "\n",
        "widgets.VBox([\n",
        "    widgets.HTML(value=\"<h3>Configure Pipeline</h3>\"),\n",
        "    select_model, select_sampler, apply_btn, out\n",
        "])"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "gradio_ui"
      },
      "execution_count": null,
      "outputs": [],
      "source": [
        "#@title 3. เปิดหน้าต่างวาดภาพ (Gradio UI)\n",
        "import gradio as gr\n",
        "import torch\n",
        "import random\n",
        "\n",
        "def generate_images(prompt, negative_prompt, width, height, steps, cfg_scale, num_images, seed):\n",
        "    if pipe is None:\n",
        "        raise gr.Error(\"กรุณากดปุ่ม Apply ในขั้นตอนที่ 2 เพื่อโหลดโมเดลก่อนครับ!\")\n",
        "\n",
        "    if seed == -1:\n",
        "        seed = random.randint(0, 2147483647)\n",
        "\n",
        "    generator = torch.Generator(\"cuda\").manual_seed(int(seed))\n",
        "\n",
        "    with torch.inference_mode():\n",
        "        images = pipe(\n",
        "            prompt=prompt,\n",
        "            negative_prompt=negative_prompt,\n",
        "            width=int(width),\n",
        "            height=int(height),\n",
        "            num_inference_steps=int(steps),\n",
        "            guidance_scale=float(cfg_scale),\n",
        "            num_images_per_prompt=int(num_images),\n",
        "            generator=generator\n",
        "        ).images\n",
        "\n",
        "    torch.cuda.empty_cache()\n",
        "    return images, f\"Seed: {seed}\"\n",
        "\n",
        "size_list = [768, 832, 1024, 1216, 1344]\n",
        "\n",
        "with gr.Blocks(theme=gr.themes.Soft()) as demo:\n",
        "    gr.Markdown(\"## Animagine XL 4.0 Studio\")\n",
        "\n",
        "    with gr.Row():\n",
        "        with gr.Column(scale=1):\n",
        "            prompt = gr.Textbox(\n",
        "                label=\"Prompt\",\n",
        "                lines=4,\n",
        "                value=\"1other, tiger, solo, safe, majestic tiger, detailed fur, jungle, forest background, cinematic lighting, vibrant colors, anime style, masterpiece, high score, great score, absurdres\"\n",
        "            )\n",
        "            neg_prompt = gr.Textbox(\n",
        "                label=\"Negative Prompt\",\n",
        "                lines=2,\n",
        "                value=\"lowres, bad anatomy, bad hands, text, error, missing finger, extra digits, fewer digits, cropped, worst quality, low quality, low score, bad score, average score, signature, watermark, username, blurry\"\n",
        "            )\n",
        "\n",
        "            with gr.Row():\n",
        "                width = gr.Dropdown(label=\"Width\", choices=size_list, value=832)\n",
        "                height = gr.Dropdown(label=\"Height\", choices=size_list, value=1216)\n",
        "\n",
        "            with gr.Row():\n",
        "                steps = gr.Slider(label=\"Steps\", minimum=15, maximum=50, step=1, value=25)\n",
        "                cfg = gr.Slider(label=\"CFG Scale\", minimum=1.0, maximum=12.0, step=0.5, value=5.0)\n",
        "\n",
        "            with gr.Row():\n",
        "                num_images = gr.Slider(label=\"Batch Size\", minimum=1, maximum=4, step=1, value=1)\n",
        "                seed = gr.Number(label=\"Seed (-1 = Random)\", value=-1, precision=0)\n",
        "\n",
        "            btn = gr.Button(\"Generate\", variant=\"primary\")\n",
        "\n",
        "        with gr.Column(scale=1):\n",
        "            gallery = gr.Gallery(label=\"Gallery\", columns=2, height=\"auto\")\n",
        "            seed_info = gr.Textbox(label=\"Info\", interactive=False)\n",
        "\n",
        "    btn.click(\n",
        "        fn=generate_images,\n",
        "        inputs=[prompt, neg_prompt, width, height, steps, cfg, num_images, seed],\n",
        "        outputs=[gallery, seed_info]\n",
        "    )\n",
        "\n",
        "demo.launch(share=True, inline=True)"
      ]
    }
